# =========================================================
# CLIENT environment (React + Vite) — copy to `.env`
# Read at BUILD time by `vite build` (must be set on your static host).
# =========================================================

# Public URL of the SEPARATELY-hosted API server (with trailing /api).
# Example: VITE_API_BASE_URL=https://seka-shalom-api.onrender.com/api
#
# If left EMPTY / omitted, the app calls same-origin `/api` — which works in
# local dev thanks to the Vite proxy (client/vite.config.js → localhost:5000).
VITE_API_BASE_URL=